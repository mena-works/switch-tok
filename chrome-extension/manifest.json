{
  "manifest_version": 3,
  "name": "Switch-Tok Login",
  "version": "1.0",
  "description": "TikTok oturumunuzu (sessionid) HttpOnly engelini aşarak Switch'e aktarır",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "https://tok.menaworks.xyz/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Switch-Tok Login"
  }
}
